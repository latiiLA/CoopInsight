# Shared defaults (copy to `.env` if missing).
# Vite also loads mode files automatically:
#   .env.development  -> `npm run dev`     (local Mongo login)
#   .env.production   -> `npm run build`   (LDAP login)
#
# Priority (later wins): .env < .env.local < .env.[mode] < .env.[mode].local
VITE_API_URL=/api
VITE_LIVE_MONITORING_ENABLED=false

# Prefer setting login type in .env.development / .env.production
# rather than editing this file when switching environments.
# VITE_LOGIN_TYPE=login
