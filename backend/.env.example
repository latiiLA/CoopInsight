JWT_SECRET=
MONGO_URL=
TIMEOUT=

DISABLE_MIGRATION=
FILE_UPLOAD_PATH=
Log_LEVEL=info

// Mail env
MAIL_SERVER=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_PORT=
MAIL_SERVER=
MAIL_RECIEVER=

// Ldap configs
LDAP_HOST=
LDAP_PORT=
LDAP_BASE_DN=
LDAP_BIND_USER=
LDAP_BIND_PASSWORD=

// ssl
CERT_FILE=
KEY_FILE=

ALLOWED_ORIGINS=

# Optional. Login uses Mongo. Set false (or omit host) to skip Oracle in local/dev.
ORACLE_ENABLED=false
ORACLE_HOST=
ORACLE_PORT=
ORACLE_SERVICE_NAME=
ORACLE_USERNAME=
ORACLE_PASSWORD=
ORACLE_TIMEOUT=30s

# Optional. Live on-us monitoring from Cortex ctxxmldump.debug over SSH.
SSH_SWITCH_ENABLED=false
SSH_SWITCH_HOST=
SSH_SWITCH_PORT=22
SSH_SWITCH_USER=
SSH_SWITCH_KEY_PATH=
SSH_SWITCH_PASSWORD=
SSH_SWITCH_DEBUG_PATH=pdir/log/debug/ctxxmldump.debug
SSH_SWITCH_TAIL_LINES=400
SSH_SWITCH_POLL_SECONDS=8
SSH_SWITCH_INSECURE=true
SSH_SWITCH_KNOWN_HOSTS=