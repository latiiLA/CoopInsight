JWT_SECRET=
REFRESH_JWT_SECRET=
ACCESS_TOKEN_EXPIRY=1h
REFRESH_TOKEN_EXPIRY=24h
MONGO_URL=
DB_NAME=coop_insights_db
APP_TIMEOUT=30s

FILE_UPLOAD_PATH=./uploads
LOG_LEVEL=info

# App Mongo schema/indexes/seeds are applied manually (see backend/db/README.md):
#   go run ./cmd/migrate all
# Bootstrap admin (required only when the system admin user is created the first time).
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_USERNAME=systemadmin
BOOTSTRAP_ADMIN_EMAIL=

# Optional. Password for seeded role test users (payswitch, payrecon, …).
# Applied only on first create. Default if unset: Test@123
# SEED_TEST_USER_PASSWORD=Test@123

# Mail env
MAIL_SERVER=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_PORT=
MAIL_RECIEVER=

# LDAP configs
LDAP_HOST=
LDAP_PORT=
LDAP_BASE_DN=
LDAP_BIND_USER=
LDAP_BIND_PASSWORD=
LDAP_TLS_MODE=none
LDAP_TLS_INSECURE_SKIP_VERIFY=false
# LDAP_CA_FILE=

# SSL (paths relative to backend/ cwd when running air / go run)
CERT_FILE=../certificates/selfsigned.crt
KEY_FILE=../certificates/selfsigned.key

ALLOWED_ORIGINS=

# Optional. Read-only TMS data. Empty SOURCE_MONGO_URL reuses MONGO_URL (same server, other DB).
SOURCE_MONGO_ENABLED=true
SOURCE_DB_NAME=coop_tms_db
SOURCE_MONGO_URL=

# Optional. ATM EJ transaction search (same MONGO_URL client, separate database).
# EJ_ENABLED=true
EJ_DB_NAME=ej_insight_db
# Linux example: /data/ej or /mnt/ejshare/Repository/EJ
# Windows example: \\server\share\Repository\EJ or D:\EJ
# Prefer forward slashes on Windows (C:/path/to/EJ). Avoid quoted backslashes; dotenv eats \U etc.
# Do not leave a second empty EJ_ROOT= later in .env; it overwrites.
EJ_ROOT=
# Background poller (default on when EJ_DB_NAME + EJ_ROOT are set). Works on Linux and Windows.
# EJ_WATCHER_ENABLED=true
EJ_POLL_INTERVAL=2m

# Optional. Login uses Mongo. Set false (or omit host) to skip Oracle in local/dev.
ORACLE_ENABLED=false
ORACLE_HOST=
ORACLE_PORT=
ORACLE_SERVICE_NAME=
ORACLE_USERNAME=
ORACLE_PASSWORD=
ORACLE_TIMEOUT=180s

# Embed surface for Grafana widgets. Leave EMBED_API_KEY blank to disable
# /api/embed entirely; the routes are then not registered at all.
# Generate a value with: openssl rand -hex 32
EMBED_API_KEY=
# Optional. Defaults to the ORACLE_TIMEOUT value.
# EMBED_API_TIMEOUT=180s

# Optional. Live on-us monitoring from Cortex ctxxmldump.debug over SSH.
SSH_SWITCH_ENABLED=false
LIVE_MONITORING_ENABLED=false
SSH_SWITCH_HOST=
SSH_SWITCH_PORT=22
SSH_SWITCH_USER=
SSH_SWITCH_KEY_PATH=
SSH_SWITCH_PASSWORD=
SSH_SWITCH_DEBUG_PATH=pdir/log/debug/ctxxmldump.debug
SSH_SWITCH_OFFUS_DEBUG_PATH=pdir/log/debug/ethfmtdump.debug
SSH_SWITCH_MC_DEBIT_DEBUG_PATH=pdir/log/debug/cirrusdump.debug
SSH_SWITCH_MC_CREDIT_DEBUG_PATH=pdir/log/debug/mcnormaldump.debug
SSH_SWITCH_VISA_DEBUG_PATH=pdir/log/debug/visadump.debug
SSH_SWITCH_IST_PATH=pdir/log/debug/monitor-ist.debug
SSH_SWITCH_TAIL_LINES=400
SSH_SWITCH_IST_TAIL_LINES=20000
SSH_SWITCH_POLL_SECONDS=8
SSH_SWITCH_INSECURE=true
SSH_SWITCH_KNOWN_HOSTS=

# Optional. MAS host for clearing batch jobs (uncleared ETH, etc.). Separate from switch live monitoring.
SSH_MAS_ENABLED=false
SSH_MAS_HOST=
SSH_MAS_PORT=22
SSH_MAS_USER=
SSH_MAS_PASSWORD=
SSH_MAS_KEY_PATH=
SSH_MAS_INSECURE=true
SSH_MAS_KNOWN_HOSTS=
SSH_MAS_TIMEOUT=60s

