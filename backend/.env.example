JWT_SECRET=
REFRESH_JWT_SECRET=
ACCESS_TOKEN_EXPIRY=1h
REFRESH_TOKEN_EXPIRY=24h
MONGO_URL=
DB_NAME=coop_insights_db
APP_TIMEOUT=30s

FILE_UPLOAD_PATH=./uploads
LOG_LEVEL=info

# App Mongo schema/indexes/seeds are applied manually (see backend/db/README.md):
#   go run ./cmd/migrate all
# Bootstrap admin (required only when the system admin user is created the first time).
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_USERNAME=systemadmin
BOOTSTRAP_ADMIN_EMAIL=

# Mail env
MAIL_SERVER=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_PORT=
MAIL_RECIEVER=

# LDAP configs
LDAP_HOST=
LDAP_PORT=
LDAP_BASE_DN=
LDAP_BIND_USER=
LDAP_BIND_PASSWORD=

# SSL
CERT_FILE=
KEY_FILE=

ALLOWED_ORIGINS=

# Optional. Read-only TMS data. Empty SOURCE_MONGO_URL reuses MONGO_URL (same server, other DB).
SOURCE_MONGO_ENABLED=true
SOURCE_DB_NAME=coop_tms_db
SOURCE_MONGO_URL=

# Optional. Login uses Mongo. Set false (or omit host) to skip Oracle in local/dev.
ORACLE_ENABLED=false
ORACLE_HOST=
ORACLE_PORT=
ORACLE_SERVICE_NAME=
ORACLE_USERNAME=
ORACLE_PASSWORD=
ORACLE_TIMEOUT=30s

# Optional. Live on-us monitoring from Cortex ctxxmldump.debug over SSH.
SSH_SWITCH_ENABLED=false
LIVE_MONITORING_ENABLED=false
SSH_SWITCH_HOST=
SSH_SWITCH_PORT=22
SSH_SWITCH_USER=
SSH_SWITCH_KEY_PATH=
SSH_SWITCH_PASSWORD=
SSH_SWITCH_DEBUG_PATH=pdir/log/debug/ctxxmldump.debug
SSH_SWITCH_OFFUS_DEBUG_PATH=pdir/log/debug/ethfmtdump.debug
SSH_SWITCH_MC_DEBIT_DEBUG_PATH=pdir/log/debug/cirrusdump.debug
SSH_SWITCH_MC_CREDIT_DEBUG_PATH=pdir/log/debug/mcnormaldump.debug
SSH_SWITCH_VISA_DEBUG_PATH=pdir/log/debug/visadump.debug
SSH_SWITCH_TAIL_LINES=400
SSH_SWITCH_POLL_SECONDS=8
SSH_SWITCH_INSECURE=true
SSH_SWITCH_KNOWN_HOSTS=
